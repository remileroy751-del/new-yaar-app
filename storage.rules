rules_version = '2';

// Règles de sécurité Firebase Storage pour Yaar-App.
service firebase.storage {
  match /b/{bucket}/o {

    // Photos de produits et logos de boutiques : lecture publique pour le marketplace,
    // écriture réservée aux utilisateurs connectés.
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 5 * 1024 * 1024;
    }
    match /shops/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 5 * 1024 * 1024;
    }

    // Pièces d'identité : jamais lisibles depuis l'app cliente. Chaque utilisateur peut
    // déposer, remplacer ou supprimer uniquement ses propres fichiers. Cela permet à la
    // suppression de compte de nettoyer les justificatifs sans les exposer publiquement.
    match /id_cards/{userId}/{fileName} {
      allow read: if false;
      allow create, update: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 8 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
