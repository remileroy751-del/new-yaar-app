rules_version = '2';

// Yaar-App : identité Firebase stable + propriété des données.
// Le mot de passe n'est jamais stocké dans Firestore : Firebase Authentication le gère.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    match /shops/{shopId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      // Autorise une fois la migration des anciennes boutiques sans ownerUid, puis
      // verrouille les modifications sur le propriétaire Firebase réel.
      allow update: if request.auth != null
                    && (!('ownerUid' in resource.data) || resource.data.ownerUid == request.auth.uid)
                    && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
                    && (!('ownerUid' in resource.data) || resource.data.ownerUid == request.auth.uid)
                    && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null
                    && (!('ownerUid' in resource.data) || resource.data.ownerUid == request.auth.uid);
    }

    match /ad_campaigns/{campaignId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    match /interests/{interestId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null;
    }
  }
}
